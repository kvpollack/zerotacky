# copy to .env.local (dev) or Vercel project env (prod). Both are public values.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# server-only (never NEXT_PUBLIC_): Resend API key and the mail key whose sha256 sits in zt_server_config (033)
RESEND_API_KEY=re_...
ZT_MAIL_KEY=64-hex-chars
